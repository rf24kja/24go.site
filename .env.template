# =============================================================
# .env — 24GO Platform Configuration
# Location on VPS: /opt/generator-ad/.env
# =============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://app_user:changeme@postgres:5432/app_db
DATABASE_URL_SYNC=postgresql://app_user:changeme@postgres:5432/app_db

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=changeme    # openssl rand -hex 32
ENCRYPTION_KEY=changeme    # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTERNAL_API_KEY=changeme

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://24go.site,https://www.24go.site,https://app.24go.site

# ── Telegram API ─────────────────────────────────────────────
TG_API_ID=00000000
TG_API_HASH=changeme

# ── Telegram Bot (optional)
BOT_TOKEN=changeme
OWNER_CHAT_ID=0

# ── LLM API (keyword fallback works without it) ─────────────
OPENROUTER_API_KEY=sk-or-v1-changeme
DEEPSEEK_API_KEY=
OPENAI_API_KEY=sk-proj-changeme

# ── VKontakte (optional)
VK_GROUP_TOKEN=
VK_SERVICE_TOKEN=

# ── SMTP ────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_changeme
SMTP_FROM=noreply@24go.site
NOTIFY_EMAIL=your@email.com

# ── Billing (optional — mock billing works) ──────────────────
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
